# ============================================================
# MicroTeach Backend Environment Configuration
# ============================================================

# --- Option A: Supabase (PostgreSQL) - RECOMMENDED FOR CLOUD / VERCEL ---
# Use the "Transaction pooler" connection string from Supabase (Port 6543)
# Settings -> Database -> Connection string -> URI (Mode: Session or Transaction)
# DATABASE_URL=postgresql://USER:PASSWORD@POOLER-HOST:6543/postgres?pgbouncer=true
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# --- Option B: Local MySQL (Development Default) ---
# Uncomment if running local MySQL instead of Supabase
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_password
# DB_NAME=microteach_db

# --- Server Settings ---
PORT=3001
NODE_ENV=development

# To switch to remote Supabase (PostgreSQL), uncomment DATABASE_URL below:
# DATABASE_URL=postgresql://USER:PASSWORD@POOLER-HOST:6543/postgres?pgbouncer=true

# Required when the frontend runs on a different origin from the API.
# FRONTEND_ORIGIN=https://your-frontend.example.com
