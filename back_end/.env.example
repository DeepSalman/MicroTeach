# ============================================================
# MicroTeach Backend Environment Configuration
# ============================================================

# --- Option A: Supabase (PostgreSQL) - RECOMMENDED FOR CLOUD / VERCEL ---
# Use the "Transaction pooler" connection string from Supabase (Port 6543)
# Settings -> Database -> Connection string -> URI (Mode: Session or Transaction)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true

# --- Option B: Local MySQL (Development Default) ---
# Uncomment if running local MySQL instead of Supabase
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_password
# DB_NAME=microteach_db

# --- Server Settings ---
PORT=3001
NODE_ENV=production
