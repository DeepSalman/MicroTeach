{
  "version": 2,
  "installCommand": "npm install && npm install --prefix front_end",
  "buildCommand": "cd front_end && npm run build",
  "outputDirectory": "front_end/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
